# --- RoboVAI Social Autopilot Configuration ---

# AI Engine API Keys (Grok and/or Gemini Free Tier)
# احصل على مفتاح Gemini المجاني 100% من: https://aistudio.google.com/
GEMINI_API_KEY=
# أو مفتاح Grok من: https://console.x.ai/
GROK_API_KEY=

# Telegram Bot & Channel
# أنشئ بوتاً مجانياً من @BotFather وضع الـ Token هنا:
TELEGRAM_BOT_TOKEN=
# معرف قناتك أو مجموعتك العامة لنشر البوستات (مثال: @robovai_pos):
TELEGRAM_CHANNEL_ID=
# معرف حسابك الشخصي على تليجرام لغرفة التحكم والموافقة (احصل عليه من @userinfobot):
TELEGRAM_ADMIN_CHAT_ID=

# Meta (Facebook Page & Instagram)
# احصل عليها مجاناً من https://developers.facebook.com/
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# X (Twitter) API v2 Free Tier
# احصل عليها مجاناً من https://developer.x.com/
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
